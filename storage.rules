rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isStaff() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin','owner'];
    }
    // Event slide images can be displayed by the public landing page; only staff may upload/change them.
    match /pengaturan/acara/slides/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
